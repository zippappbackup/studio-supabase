
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null &&
        (request.auth.token.admin == true ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
    }

    // --- TEMPORARY ADMIN OVERRIDE ---
    // Allow any user with the 'admin' role in their user document to read/write anything.
    // This is a broad rule to unblock the migration process.
    match /{path=**} {
      allow read, write: if isAdmin();
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    
    function isVendorOwner(vendorId) {
        // Allow if the user is the claimed owner, OR if they are creating a new vendor doc with their own UID.
        return request.auth != null && 
               (get(/databases/$(database)/documents/vendors/$(vendorId)).data.claimedBy == request.auth.uid ||
                vendorId == request.auth.uid);
    }

    match /users/{userId} {
      // Allow any authenticated user to create their own user document.
      allow create: if request.auth.uid == userId;
      
      // Allow a user to read or update their own document.
      allow read, update: if isOwner(userId);

      // Disallow deleting user documents.
      allow delete: if false; 
    }
    
    match /vendors/{vendorId} {
      allow read: if true;
      allow delete: if isAdmin();
      // Allow admins, the owner, OR a user submitting a review/redeeming a promo/viewing a profile to update specific fields.
      // ADDITION: Also allow a logged-in user to claim a vendor if it's currently unclaimed.
      allow update: if isAdmin() || isVendorOwner(vendorId) ||
                    (request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reviews', 'zippRating', 'zippReviewCount', 'updatedAt', 'promotions', 'profileViews'])) ||
                    (request.auth != null && (!('claimedBy' in resource.data) || resource.data.claimedBy == null || resource.data.claimedBy == "") && request.resource.data.claimedBy == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy', 'subscriptionStatus', 'updatedAt']));
      allow create: if isAdmin() || (request.auth != null && request.auth.uid == vendorId); // Only admins or the user themselves can create a vendor doc with their uid

      match /offerings/{offeringId} {
        allow read: if true;
        allow write: if isAdmin() || isVendorOwner(vendorId);
      }

      match /reviews/{reviewId} {
        allow read: if true;
        allow write: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
      }
    }
    
    match /featuredMerchants/singleton {
        allow read: if true;
        allow write: if false;
    }
    
    match /zippHighlights/singleton {
        allow read: if true;
        // The "allow write: if false;" has been removed.
        // Writes will now be allowed by backend processes with admin privileges.
    }
    
    match /todaysHotDeals/singleton {
        allow read: if true;
        allow write: if false; // Only backend can write
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /promotions/{promotionId} {
      allow read: if true;
      // Allow vendor owner to manage their promotions
      allow write: if request.auth != null && isVendorOwner(request.resource.data.vendorId);
    }

    match /adminConfig/global {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
     
    match /config/vendorDataset {
       allow read: if true;
       allow write: if false; // Only backend functions can write here
    }

    match /userActivityLogs/{logId} {
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if false;
    }

    match /verificationSignals/{userId} {
      allow write: if true; 
      allow read, update, delete: if false;
    }

    match /scrapeCache/{cacheId} {
      allow read, write: if isAdmin();
    }
    
    match /imageMigrationTasks/{taskId} {
      allow read, write: if isAdmin();
    }
    
    match /vendorsWithInvalidPhotos/{vendorId} {
        allow read, write: if isAdmin();
    }

    // Default deny for other collections unless specified
    match /orders/{orderId} { allow read, write: if false; }
    match /bookings/{bookingId} { allow read, write: if false; }
    match /subscriptions/{subscriptionId} { allow read, write: if false; }
  }
}
