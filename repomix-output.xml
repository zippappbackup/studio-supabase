  "firestore": {
    "structure": [
      {
        "path": "users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": {
            "$ref": "#/backend/entities/User"
          },
          "description": "Stores user profiles. Document ID is the Firebase Auth UID. Includes user role for authorization independence.",
          "params": [
            {
              "name": "userId",
              "description": "The Firebase Auth UID of the user."
            }
          ]
        }
      },
      {
        "path": "vendors/{vendorId}",
        "definition": {
          "entityName": "Vendor",
          "schema": {
            "$ref": "#/backend/entities/Vendor"
          },
          "description": "Stores vendor profiles. VendorId is the document ID.",
          "params": [
            {
              "name": "vendorId",
              "description": "The unique identifier for the vendor."
            }
          ]
        }
      },
      {
        "path": "zippHighlights/singleton",
        "definition": {
          "entityName": "ZippHighlights",
          "schema": { "$ref": "#/backend/entities/ZippHighlights" },
          "description": "A singleton document containing an array of 8 full vendor objects to be featured as Zipp Highlights on the homepage. This document is updated periodically by a scheduled Cloud Function.",
          "params": []
        }
      },
      {
        "path": "vendors/{vendorId}/offerings/{offeringId}",
        "definition": {
          "entityName": "Offering",
          "schema": {
            "$ref": "#/backend/entities/Offering"
          },
          "description": "Stores products or services offered by a vendor. This is a sub-collection of a vendor.",
          "params": [
            {
              "name": "vendorId",
              "description": "The unique identifier for the vendor."
            },
            {
              "name": "offeringId",
              "description": "The unique identifier for the offering."
            }
          ]
        }
      },
       {
        "path": "vendors/{vendorId}/reviews/{reviewId}",
        "definition": {
          "entityName": "Review",
          "schema": { "$ref": "#/backend/entities/Review" },
          "description": "Stores user reviews for a specific vendor. This is a sub-collection of a vendor.",
          "params": [
            { "name": "vendorId", "description": "The unique identifier for the vendor." },
            { "name": "reviewId", "description": "The unique identifier for the review." }
          ]
        }
      },
      {
        "path": "categories/{categoryId}",
        "definition": {
          "entityName": "Category",
          "schema": {
            "$ref": "#/backend/entities/Category"
          },
          "description": "Stores vendor categories. CategoryId is the document ID.",
          "params": [
            {
              "name": "categoryId",
              "description": "The unique identifier for the category."
            }
          ]
        }
      },
      {
        "path": "promotions/{promotionId}",
        "definition": {
          "entityName": "Promotion",
          "schema": {
            "$ref": "#/backend/entities/Promotion"
          },
          "description": "Stores promotions offered by vendors. PromotionId is the document ID. Includes denormalized vendorId for authorization independence.",
          "params": [
            {
              "name": "promotionId",
              "description": "The unique identifier for the promotion."
            }
          ]
        }
      },
      {
        "path": "orders/{orderId}",
        "definition": {
          "entityName": "Order",
          "schema": {
            "$ref": "#/backend/entities/Order"
          },
          "description": "Stores orders placed by users. OrderId is the document ID. Includes userId and vendorId for authorization independence.",
          "params": [
            {
              "name": "orderId",
              "description": "The unique identifier for the order."
            }
          ]
        }
      },
      {
        "path": "bookings/{bookingId}",
        "definition": {
          "entityName": "Booking",
          "schema": {
            "$ref": "#/backend/entities/Booking"
          },
          "description": "Stores bookings made by users. BookingId is the document ID. Includes userId and vendorId for authorization independence.",
          "params": [
            {
              "name": "bookingId",
              "description": "The unique identifier for the booking."
            }
          ]
        }
      },
      {
        "path": "listings/{listingId}",
        "definition": {
          "entityName": "Listing",
          "schema": {
            "$ref": "#/backend/entities/Listing"
          },
          "description": "Stores listings created by users. ListingId is the document ID. Includes userId for authorization independence.",
          "params": [
            {
              "name": "listingId",
              "description": "The unique identifier for the listing."
            }
          ]
        }
      },
      {
        "path": "offers/{offerId}",
        "definition": {
          "entityName": "Offer",
          "schema": {
            "$ref": "#/backend/entities/Offer"
          },
          "description": "Stores offers made on listings. OfferId is the document ID. Includes listingId and vendorId for authorization independence.",
          "params": [
            {
              "name": "offerId",
              "description": "The unique identifier for the offer."
            }
          ]
        }
      },
       {
        "path": "geocodeCache/{query}",
        "definition": {
          "entityName": "GeocodeCache",
          "schema": { "$ref": "#/backend/entities/GeocodeCache" },
          "description": "Stores geocoding results to minimize external API calls. Document ID is the normalized search query.",
          "params": [
            { "name": "query", "description": "The normalized search query used for caching." }
          ]
        }
      },
