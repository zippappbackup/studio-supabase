    overflow: hidden;
    background-color: var(--fog-base);
  }

  .fog-background::before,
  .fog-background::after {
    content: "";
    position: absolute;
    inset: -150%;
    filter: blur(60px);
    pointer-events: none;
    border-radius: 50%;
  }
  
  .fog-background::before {
    background: radial-gradient(circle at 10% 20%, var(--fog-highlight) 15%, transparent 40%),
                radial-gradient(circle at 80% 30%, var(--fog-midtone) 20%, transparent 50%);
    animation: drift var(--fog-speed) infinite linear alternate;
    z-index: 1;
  }

  .fog-background::after {
    background: radial-gradient(circle at 30% 80%, var(--fog-lowlight) 18%, transparent 45%),
                radial-gradient(circle at 75% 55%, var(--fog-midtone) 15%, transparent 40%);
    animation: drift-reverse var(--fog-speed) infinite linear alternate;
    z-index: 2;
    opacity: 0.85;
  }
}

@keyframes drift {
  0% { transform: translate(-20%, -20%) scale(var(--fog-zoom-1)); }
  25% { transform: translate(0%, 20%) scale(var(--fog-zoom-2)); }
  50% { transform: translate(20%, -10%) scale(var(--fog-zoom-1)); }
  75% { transform: translate(0%, 0%) scale(var(--fog-zoom-2)); }
  100% { transform: translate(-20%, -20%) scale(var(--fog-zoom-1)); }
}

@keyframes drift-reverse {
  0% { transform: translate(20%, 25%) scale(var(--fog-zoom-2)); }
  25% { transform: translate(0%, -15%) scale(var(--fog-zoom-1)); }
  50% { transform: translate(-20%, 20%) scale(var(--fog-zoom-2)); }
  75% { transform: translate(10%, 0%) scale(var(--fog-zoom-1)); }
  100% { transform: translate(20%, 25%) scale(var(--fog-zoom-2)); }
}

@layer components {
  /* Custom style for unobtrusive Leaflet attribution */
  .leaflet-control-attribution {
    font-size: 11px;
