                                    </TableCell>
                                </TableRow>
                            ))}
                        </TableBody>
                    </Table>
                </CardContent>
            </Card>

            <OfferingEditDialog
                isOpen={isDialogOpen}
                setIsOpen={setIsDialogOpen}
                offering={selectedOffering}
            />
        </div>
    );
}
